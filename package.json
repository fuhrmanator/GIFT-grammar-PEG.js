{
    "name": "gift-pegjs",
    "version": "1.0.2",
    "description": "Parser of GIFT question format based on PEG.js",
    "main": "pegjs-gift.js",
    "types": "./types/index.d.ts",
    "dependencies": {
        "pegjs": "^0.10.x"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.7",
        "connect": "^3.6.6",
        "glob": "^11.0.1",
        "jest": "^29.7.0",
        "pegjs-backtrace": "^0.2.1",
        "serve-static": "^1.16.2",
        "ts-jest": "^29.2.5",
        "typescript": "^5.7.3"
    },
    "files": [
        "GIFT.pegjs",
        "lib",
        "types"
    ],
    "scripts": {
        "build": "pegjs --format globals --export-var giftParser -o lib/GIFT-globals.js GIFT.pegjs && cp lib/GIFT-globals.js pegjs-gift-globals.js && pegjs -o lib/GIFT.js GIFT.pegjs && cp lib/GIFT.js pegjs-gift.js && bash makeHTML.sh && cp GIFT.pegjs docs/editor/lib/",
        "test": "jest --colors"
    },
    "repository": "github:fuhrmanator/GIFT-grammar-PEG.js",
    "author": "Christopher Fuhrman",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/fuhrmanator/GIFT-grammar-PEG.js/issues"
    },
    "homepage": "https://github.com/fuhrmanator/GIFT-grammar-PEG.js#gift-grammar-pegjs"
}
