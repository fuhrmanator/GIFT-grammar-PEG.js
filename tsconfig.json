{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "ES6",
    "moduleResolution": "node",
    "outDir": "./lib",  // transpiled typeGuards.ts
    "declaration": true,
    "declarationDir": "./lib",
    "baseUrl": ".",
    "paths": {
      "gift-pegjs": ["./types/gift-pegjs/index.d.ts"],
      "gift-pegjs/typeGuards": ["./lib/typeGuards.d.ts"],
    },
    "typeRoots": ["./types", "./node_modules/@types"],
    "types": ["jest"],
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": false
  },
  "include": ["types/**/*", "src/**/*"],
  // don't transpile the tests
  "exclude": ["node_modules", "tests/**/*"]
}
